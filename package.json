{
  "name": "finsight",
  "version": "1.0.0",
  "private": true,
  "description": "FinSight - Intelligent personal finance management platform. See your money differently.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:cleanup-tests": "tsx prisma/cleanup-test-users.ts",
    "setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "motion-dom": "12.23.21",
    "motion-utils": "12.23.6",
    "rollup": "npm:@rollup/wasm-node@4.52.4"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "framer-motion": "12.23.22",
    "lucide-react": "0.544.0",
    "next": "15.5.29",
    "next-themes": "0.4.6",
    "papaparse": "5.5.3",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.2.1",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "swr": "2.3.6",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@tailwindcss/oxide@4.1.13": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
